# App Store delivery configuration

app_identifier("com.noah.Marks")

# Metadata directory
metadata_path("./fastlane/metadata")
screenshots_path("./fastlane/screenshots")

# Submission settings
submit_for_review(true)
automatic_release(true)
skip_binary_upload(false)

# Precheck can't inspect IAPs with API-key auth (and this app has none)
precheck_include_in_app_purchases(false)

# App review info (demo account for reviewer)
app_review_information(
  demo_user: "reviewer@getmarks.sh",
  demo_password: "ReviewMarks2026!",
  notes: "Resubmission for the 1.4.5 rejection:\n" \
         "- Guideline 2.1(a): Saving a bookmark no longer blocks on the network. " \
         "Tapping Save now stores the bookmark on-device and dismisses immediately; " \
         "the server sync happens in the background. Covered by a UI test run on an 11-inch iPad.\n" \
         "- Guideline 2.3.6: Age Rating now declares Unrestricted Web Access = Yes."
)

# Pricing: managed in App Store Connect (free). Re-uploading it hits
# removed API attributes (availableInNewTerritories) on older fastlane.
# price_tier(0)

# App rating: already set in App Store Connect; the local config uses
# age-rating keys Apple's API has since renamed (GAMBLING_CONTEST), which
# makes the upload fail. Leave it managed in ASC.
# app_rating_config_path("./fastlane/rating_config.json")

# Categories
primary_category("UTILITIES")
secondary_category("PRODUCTIVITY")
