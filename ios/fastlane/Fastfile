default_platform(:ios)

XCODEPROJ = "Marks.xcodeproj"
SCHEME = "Marks"

# Update MARKETING_VERSION or CURRENT_PROJECT_VERSION in the pbxproj directly,
# avoiding agvtool which hardcodes values into Info.plists.
PBXPROJ = File.expand_path("../#{XCODEPROJ}/project.pbxproj", __dir__)

def set_pbxproj_value(key, value)
  content = File.read(PBXPROJ)
  updated = content.gsub(/#{key} = [^;]+;/, "#{key} = #{value};")
  File.write(PBXPROJ, updated)
end

def get_pbxproj_value(key)
  content = File.read(PBXPROJ)
  match = content.match(/#{key} = ([^;]+);/)
  match ? match[1] : nil
end

API_KEY_PATH = File.expand_path("~/.appstoreconnect/AuthKey_LXHRKTW3J6.p8")
API_KEY_ID = "LXHRKTW3J6"
API_ISSUER_ID = "c69ffd7a-8a60-457a-8af1-657dada57476"

# xcodebuild flags for cloud-managed signing (creates distribution cert +
# provisioning profiles on demand using the ASC API key)
CLOUD_SIGNING_XCARGS = [
  "-allowProvisioningUpdates",
  "-authenticationKeyPath #{API_KEY_PATH}",
  "-authenticationKeyID #{API_KEY_ID}",
  "-authenticationKeyIssuerID #{API_ISSUER_ID}"
].join(" ")

def authenticate_app_store_connect
  app_store_connect_api_key(
    key_id: API_KEY_ID,
    issuer_id: API_ISSUER_ID,
    key_filepath: API_KEY_PATH,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  before_all do
    # Point to Xcode.app without needing sudo (DEVELOPER_DIR overrides xcode-select)
    ENV["DEVELOPER_DIR"] = "/Applications/Xcode.app/Contents/Developer"
  end

  desc "Take App Store screenshots"
  lane :screenshots do
    ["iPhone 16 Pro Max", "iPhone 16 Pro"].each do |device|
      capture_screenshots(devices: [device])
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = authenticate_app_store_connect

    # Auto-increment build number
    build = (get_pbxproj_value("CURRENT_PROJECT_VERSION") || "0").to_i + 1
    set_pbxproj_value("CURRENT_PROJECT_VERSION", build)
    UI.success("Build number → #{build}")

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      clean: true,
      # Cloud signing: let xcodebuild mint the distribution cert + profiles
      # via the ASC API key (no local signing assets needed)
      xcargs: CLOUD_SIGNING_XCARGS,
      # gym already forwards the ASC API key to exportArchive; adding the
      # -authenticationKey* flags again makes xcodebuild error on duplicates
      export_xcargs: "-allowProvisioningUpdates",
      export_options: { signingStyle: "automatic" }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Upload only — re-uses the existing Marks.ipa (no rebuild)"
  lane :upload_only do
    api_key = authenticate_app_store_connect
    upload_to_testflight(
      api_key: api_key,
      ipa: "Marks.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata and screenshots to App Store"
  lane :release do
    api_key = authenticate_app_store_connect
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      force: true
    )
  end

  desc "Full release: build, upload binary + metadata"
  lane :ship do
    setup_ci if ENV["CI"]
    api_key = authenticate_app_store_connect

    build = (get_pbxproj_value("CURRENT_PROJECT_VERSION") || "0").to_i + 1
    set_pbxproj_value("CURRENT_PROJECT_VERSION", build)
    UI.success("Build number → #{build}")

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      clean: true,
      # Cloud signing: let xcodebuild mint the distribution cert + profiles
      # via the ASC API key (no local signing assets needed)
      xcargs: CLOUD_SIGNING_XCARGS,
      # gym already forwards the ASC API key to exportArchive; adding the
      # -authenticationKey* flags again makes xcodebuild error on duplicates
      export_xcargs: "-allowProvisioningUpdates",
      export_options: { signingStyle: "automatic" }
    )
    deliver(api_key: api_key, force: true)
  end

  desc "Upload existing Marks.ipa to App Store + push metadata (no rebuild)"
  lane :ship_upload_only do
    api_key = authenticate_app_store_connect
    deliver(
      api_key: api_key,
      ipa: "Marks.ipa",
      force: true
    )
  end

  desc "Bump version number (e.g. fastlane bump version:1.4.1)"
  lane :bump do |options|
    version = options[:version]
    UI.user_error!("Usage: fastlane bump version:X.Y.Z") unless version

    set_pbxproj_value("MARKETING_VERSION", version)
    UI.success("Version bumped to #{version}")
  end
end
